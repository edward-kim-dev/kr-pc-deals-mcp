# kr-pc-deals-mcp 환경변수 (로컬 개발용)
#
# ⚠️ 이 파일은 git clone 후 `npm run dev`로 로컬에서 직접 실행할 때만 의미가 있습니다.
# `npx kr-pc-deals-mcp`로 실행되는 MCP 서버는 이 파일을 찾을 수 없습니다.
# Claude Desktop/Code/Cursor에서 환경변수를 설정하려면 MCP 클라이언트 설정 파일의
# "env" 필드를 사용하세요. README의 "쿠팡 활성화" 섹션을 참고하세요.

# 쿠팡 검색 — 브라우저 모드 (선택사항, 실험적)
# 설치된 Chrome 계열 브라우저로 쿠팡 공개 검색 페이지를 읽습니다.
# 미설정 시 쿠팡은 비활성(다나와/컴퓨존만 동작).
# ⚠️ 개인 용도 한정 — 쿠팡 이용약관·페이지 구조 변경에 따라 동작하지 않을 수 있습니다.
# COUPANG_MODE=browser
# 자동 탐지되지 않을 때만 실행 파일의 절대 경로를 지정하세요.
# COUPANG_BROWSER_EXECUTABLE_PATH=

# 캐시 TTL (초)
CACHE_TTL_SEARCH=1800
CACHE_TTL_PRODUCT=3600
CACHE_TTL_HISTORY=21600

# 요청 딜레이 (밀리초)
REQUEST_DELAY_MS=1500
